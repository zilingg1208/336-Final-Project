Airports(
    airport_id CHAR(3) PRIMARY KEY
)
Airlines(
    aid CHAR(2) PRIMARY KEY
)
Aircraft(
    aircraft_id INT PRIMARY KEY,
    aid CHAR(2),
    capacity INT,
    FOREIGN KEY (aid) REFERENCES Airlines(aid)
)
Flights(
    aid CHAR(2),
    flight_number INT,
    aircraft_id INT,
    departure_airport CHAR(3),
    destination_airport CHAR(3),
    departure_datetime DATETIME,
    arrival_datetime DATETIME,
    price DECIMAL(10,2),
    stops INT,
    type VARCHAR(20),

    PRIMARY KEY (aid, flight_number),
    FOREIGN KEY (aid) REFERENCES Airlines(aid),
    FOREIGN KEY (aircraft_id) REFERENCES Aircraft(aircraft_id),
    FOREIGN KEY (departure_airport) REFERENCES Airports(airport_id),
    FOREIGN KEY (destination_airport) REFERENCES Airports(airport_id)
)
Customers(
    cid INT PRIMARY KEY,
    name VARCHAR(50),
    email VARCHAR(100),
    username VARCHAR(50),
    password VARCHAR(50)
)
Tickets(
    ticket_id INT PRIMARY KEY AUTO_INCREMENT,
    cid INT,
    total_fare DECIMAL(10,2),
    booking_fee DECIMAL(10,2),
    purchase_time DATETIME,
    type VARCHAR(20),
    status VARCHAR(20),

    FOREIGN KEY (cid) REFERENCES Customers(cid)
)
Includes(
    ticket_id INT,
    aid CHAR(2),
    flight_number INT,
    departure_datetime DATETIME,
    seat_number VARCHAR(10),
    class VARCHAR(20),
    special_meal VARCHAR(50),

    PRIMARY KEY (ticket_id, aid, flight_number),
    FOREIGN KEY (ticket_id) REFERENCES Tickets(ticket_id),
    FOREIGN KEY (aid, flight_number) REFERENCES Flights(aid, flight_number)
)
Waiting_List(
    ticket_id INT,
    aid CHAR(2),
    flight_number INT,
    position INT,

    PRIMARY KEY (ticket_id, aid, flight_number),
    FOREIGN KEY (ticket_id) REFERENCES Tickets(ticket_id),
    FOREIGN KEY (aid, flight_number) REFERENCES Flights(aid, flight_number)
)
Questions(
    qid INT PRIMARY KEY AUTO_INCREMENT,
    cid INT,
    eid INT NULL,
    question TEXT,
    response TEXT,
    status VARCHAR(20),

    FOREIGN KEY (cid) REFERENCES Customers(cid)
)

Notes:
- ticket_id and qid are AUTO_INCREMENT
- Flights uses composite primary key (aid, flight_number)
- Includes and Waiting_List depend on both Tickets and Flights
- eid in Questions represents the employee (customer representative)
- eid is NULL until a representative responds
